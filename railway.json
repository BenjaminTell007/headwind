{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "watchPatterns": [
      "server/**",
      "contracts/**",
      "scripts/**",
      "data/**",
      "requirements.txt",
      ".python-version",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": "python -m uvicorn server.app:app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ALWAYS"
  }
}
